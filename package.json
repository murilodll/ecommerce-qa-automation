		"doc": "docs",
		"test": "tests",
		"config": "config",
		"utils": "utils",
		"data": "data"
	},
	"type": "module",
	"scripts": {
		"test": "npx bddgen -c config/playwright.config.ts && npx playwright test -c config/playwright.config.ts",
