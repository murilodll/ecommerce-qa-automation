{
	"name": "ecommerce-qa-automation",
	"version": "1.0.0",
	"private": true,
	"author": "Murilo de Lavor Lacerda",
	"license": "MIT",
	"description": "End-to-end QA automation project with Playwright BDD, REST Assured API tests, manual test management and a Streamlit dashboard.",
	"directories": {
		"config": "config",
		"data": "data",
		"docs": "docs",
		"reports": "reports",
		"src": "src",
		"tests": "tests",
		"utils": "utils"
	},
	"type": "module",
	"scripts": {
		"test": "npx bddgen -c config/playwright.config.ts && npx playwright test -c config/playwright.config.ts",
		"test:api": "mvn test -f tests/api/pom.xml",
		"test:api:known-bugs": "mvn test -f tests/api/pom.xml -Pknown-bugs",
		"playwright-report": "npx playwright show-report reports/playwright-report",
		"cucumber-report": "npx playwright show-report reports/cucumber-report",
		"playwright-ui": "npx playwright test --ui -c config/playwright.config.ts",
		"playwright-debug": "npx playwright test --debug -c config/playwright.config.ts"
	},
	"keywords": [
		"qa",
		"test-automation",
		"playwright",
		"playwright-bdd",
		"rest-assured",
		"api-testing",
		"gherkin",
		"streamlit",
		"e2e-testing"
	],
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.6.4",
		"playwright-bdd": "^9.2.1",
		"typescript": "^7.0.2"
	}
}
